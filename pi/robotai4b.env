# RobotAI4B - Raspberry Pi ayarları (setup_pi.sh ve run_server.sh bu dosyayı okur).
# Her değer ortam değişkeniyle geçersiz kılınabilir, ör.:  PORT=9000 bash pi/run_server.sh

# --- Model -------------------------------------------------------------------
# Varsayılan: ince ayarsız Gemma 4 E4B (Türkçesi zaten iyi).
# Kendi birleştirilmiş modelinizi Hugging Face'e yüklediyseniz, ör.:
#   MODEL_REPO=kullaniciadi/robotai4b-GGUF
#   MODEL_FILE=robotai4b-Q4_K_M.gguf
MODEL_REPO=${MODEL_REPO:-unsloth/gemma-4-E4B-it-GGUF}
MODEL_FILE=${MODEL_FILE:-gemma-4-E4B-it-Q4_K_M.gguf}

# Seçenek B: Temel modeli değiştirmeden sadece LoRA adaptörü (export_lora_gguf.sh çıktısı).
# Boş bırakılırsa LoRA kullanılmaz. Ör.:
#   LORA_REPO=kullaniciadi/robotai4b-GGUF
#   LORA_FILE=robotai4b-lora-F16.gguf
LORA_FILE=${LORA_FILE:-}
LORA_REPO=${LORA_REPO:-$MODEL_REPO}

# Modellerin indirileceği klasör
MODEL_DIR=${MODEL_DIR:-$HOME/robotai4b/models}

# llama.cpp kurulum klasörü
LLAMA_DIR=${LLAMA_DIR:-$HOME/robotai4b/llama.cpp}

# --- Sunucu ------------------------------------------------------------------
HOST=${HOST:-127.0.0.1}   # Ağdaki diğer cihazlardan erişim için 0.0.0.0
PORT=${PORT:-8080}
CTX=${CTX:-4096}          # Bağlam uzunluğu (token). Daha fazlası daha çok RAM ister.
THREADS=${THREADS:-4}     # Pi 5'te 4 çekirdek var
